{
  "name": "want",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "assets:check": "node scripts/prepare-assets.mjs --check",
    "predev": "npm run assets:prepare",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run assets:prepare",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run assets:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
